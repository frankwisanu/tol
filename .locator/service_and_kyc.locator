# Service Selection & KYC Locators Repository (.locator)
# Project: True Online (TOL) Automation Standard

[Service_Selection]
lbl_service_title          = xpath://h1[contains(text(),'เลือกบริการที่ต้องการสมัคร')]
chk_service_internet       = xpath://input[@id='service-tol-internet']
chk_service_mobile_tmh     = xpath://input[@id='service-tmh-mobile']
chk_service_trueid_tv      = xpath://input[@id='service-trueid-tv']
chk_service_fixed_line     = xpath://input[@id='service-flp-fixedline']
radio_sales_channel_online = xpath://input[@name='salesChannel' and @value='ONLINE']
radio_sales_channel_direct = xpath://input[@name='salesChannel' and @value='OFFLINE_DIRECT']
btn_service_next           = xpath://button[@id='btn-service-next' or contains(text(),'ถัดไป')]

[Customer_ID_Validation]
tab_thai_id                = xpath://div[@role='tab' and contains(text(),'บัตรประชาชน')]
tab_passport               = xpath://div[@role='tab' and contains(text(),'หนังสือเดินทาง')]
tab_alien_card             = xpath://div[@role='tab' and contains(text(),'บัตรต่างด้าว')]
tab_work_permit            = xpath://div[@role='tab' and contains(text(),'ใบอนุญาตทำงาน')]
input_card_number          = xpath://input[@id='input-card-number']
input_first_name           = xpath://input[@id='input-first-name']
input_last_name            = xpath://input[@id='input-last-name']
input_birth_date           = xpath://input[@id='input-birth-date']
input_expiry_date          = xpath://input[@id='input-expiry-date']
btn_validate_eligibility   = xpath://button[@id='btn-validate-tol']
btn_cust_next              = xpath://button[@id='btn-cust-next' or contains(text(),'ถัดไป')]

[Customer_Self_KYC_QR]
btn_generate_qr            = xpath://button[@id='btn-generate-qr']
img_qr_code                = xpath://img[@id='qr-code-verification']
lbl_ref_code               = xpath://span[@id='lbl-ref-code']
badge_kyc_status           = xpath://div[contains(@class,'kyc-status-indicator')]
btn_bypass_qr              = xpath://button[contains(text(),'สมัครบริการโดยไม่ใช้ QR Code')]
btn_submit_kyc             = xpath://button[@id='btn-submit-kyc' or contains(text(),'ยืนยันตัวตน')]
