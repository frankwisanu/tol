# Package, Appointment & Order Submission Locators (.locator)
# Project: True Online (TOL) Automation Standard

[Privilege_Selection]
radio_privilege_general    = xpath://input[@name='privilegeGroup' and @value='GENERAL']
radio_privilege_cp_emp     = xpath://input[@name='privilegeGroup' and @value='CPemp']
radio_privilege_fmc        = xpath://input[@name='privilegeGroup' and @value='FMC_TRUE_DTAC']
select_fmc_mobile          = xpath://select[@id='sel-fmc-mobile-number']
btn_privilege_next         = xpath://button[@id='btn-privilege-next' or contains(text(),'ถัดไป')]

[Package_Catalog]
tab_filter_ftth            = xpath://button[contains(text(),'FTTH')]
card_package_item          = xpath://div[contains(@class,'package-card')]
radio_waive_entry_fee_yes  = xpath://input[@name='waiveEntryFee' and @value='Y']
btn_package_next           = xpath://button[@id='btn-package-next' or contains(text(),'ถัดไป')]

[Customer_Contact_Billing]
input_primary_mobile       = xpath://input[@id='input-primary-mobile']
input_backup_mobile        = xpath://input[@id='input-backup-mobile']
radio_bill_delivery_sms    = xpath://input[@name='billDelivery' and @value='SMS']
radio_bill_delivery_email  = xpath://input[@name='billDelivery' and @value='EMAIL']
btn_cust_info_next         = xpath://button[@id='btn-cust-info-next' or contains(text(),'ถัดไป')]

[Installation_Appointment]
radio_install_standard     = xpath://input[@name='installType' and @value='STANDARD']
radio_install_special      = xpath://input[@name='installType' and @value='SPECIAL']
cell_available_date        = xpath://td[contains(@class,'calendar-day-available')]
radio_slot_morning         = xpath://input[@name='timeSlot' and @value='MORNING']
radio_slot_afternoon       = xpath://input[@name='timeSlot' and @value='AFTERNOON']
btn_appointment_next       = xpath://button[@id='btn-appointment-next' or contains(text(),'ถัดไป')]

[Order_Review_And_Submission]
lbl_summary_customer_name  = xpath://span[@id='summary-customer-name']
lbl_summary_package_name   = xpath://span[@id='summary-package-name']
chk_accept_terms           = xpath://input[@id='chk-terms-conditions']
pad_signature_canvas       = xpath://canvas[@id='customer-signature-canvas']
btn_confirm_order          = xpath://button[@id='btn-confirm-order' or contains(text(),'ยืนยันการสมัคร')]
lbl_submitted_order_id     = xpath://span[@id='lbl-submitted-order-id']
badge_status_success       = xpath://div[contains(text(),'ส่งคำขอสำเร็จ')]
