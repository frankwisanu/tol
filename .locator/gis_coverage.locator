# SGIS Check Coverage Locators Repository (.locator)
# Project: True Online (TOL) Automation Standard

[Webview_Navigation]
sgis_webview_container     = xpath://div[contains(@class,'sgis-webview-container')]
btn_gis_back               = xpath://button[@id='btn-gis-back' or contains(@class,'back-arrow')]
modal_cancel_confirm       = xpath://div[contains(@class,'confirm-exit-dialog')]
btn_confirm_yes            = xpath://button[contains(text(),'ต้องการ') and not(contains(text(),'ไม่'))]
btn_confirm_no             = xpath://button[contains(text(),'ไม่ต้องการ')]

[Map_Search_Pin]
input_location_search      = xpath://input[@id='input-gis-search' or @placeholder='ค้นหาที่อยู่หรือพิกัด']
btn_search_submit          = xpath://button[@id='btn-search-location']
pin_map_marker             = xpath://div[contains(@class,'gis-map-marker')]
btn_confirm_location       = xpath://button[@id='btn-confirm-location']

[Coverage_Status_Badges]
badge_coverage_green       = xpath://div[@data-coverage='GREEN' or contains(@class,'coverage-green')]
badge_coverage_yellow      = xpath://div[@data-coverage='YELLOW' or contains(@class,'coverage-yellow')]
badge_coverage_red         = xpath://div[@data-coverage='RED' or contains(@class,'coverage-red')]

[Over_Cable_Approval]
radio_house_private        = xpath://input[@name='houseType' and @value='PRIVATE']
radio_house_rental         = xpath://input[@name='houseType' and @value='RENTAL']
chk_accept_overcable_fee   = xpath://input[@id='chk-accept-overcable']

[Action_Buttons]
btn_register_service       = xpath://button[@id='btn-register-tol' or contains(text(),'สมัครบริการ')]
btn_enroll_waiting_list    = xpath://button[@id='btn-waiting-list' or contains(text(),'ลงชื่อสนใจบริการ')]
